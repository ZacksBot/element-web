// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ImageBodyView > renders the default image state 1`] = `
<div>
  <div
    class="root mx_MImageBody"
  >
    <a
      class="interactiveWrapper"
      href="https://example.com/image.png"
    >
      <div
        class="mx_MImageBody_thumbnail_container thumbnailContainer"
        style="max-height: 180px; max-width: 320px; aspect-ratio: 16 / 9;"
      >
        <div
          style="max-height: 180px; max-width: 320px;"
        >
          <img
            alt="A scenic mountain lake"
            class="mx_MImageBody_thumbnail thumbnail"
            src="data:image/svg+xml;utf8,%0A%20%20%20%20%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%20viewBox%3D%220%200%20320%20180%22%3E%0A%20%20%20%20%20%20%20%20%3Cdefs%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%25%22%20y1%3D%220%25%22%20x2%3D%22100%25%22%20y2%3D%22100%25%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%220%25%22%20stop-color%3D%22%23b3d4ff%22%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%22100%25%22%20stop-color%3D%22%23f7c7ff%22%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2FlinearGradient%3E%0A%20%20%20%20%20%20%20%20%3C%2Fdefs%3E%0A%20%20%20%20%20%20%20%20%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22url(%23g)%22%2F%3E%0A%20%20%20%20%20%20%20%20%3Ccircle%20cx%3D%2282%22%20cy%3D%2282%22%20r%3D%2234%22%20fill%3D%22%23fff6%22%2F%3E%0A%20%20%20%20%20%20%20%20%3Cpath%20d%3D%22M30%20150%20L130%2088%20L190%20138%20L240%20102%20L320%20180%20L0%20180%20Z%22%20fill%3D%22%231f3a5f%22%2F%3E%0A%20%20%20%20%3C%2Fsvg%3E%0A"
          />
        </div>
      </div>
    </a>
  </div>
</div>
`;

exports[`ImageBodyView > renders the error state 1`] = `
<div>
  <div
    class="root mx_MImageBody"
  >
    <span
      class="error"
    >
      <svg
        class="mx_MediaProcessingError_Icon errorIcon"
        fill="currentColor"
        height="1em"
        viewBox="0 0 24 24"
        width="1em"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M5 3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7.803a6 6 0 0 1-.72-2H5v-3.172l4-4 3.585 3.585a6 6 0 0 1 1.172-1.656l-3.343-3.343a2 2 0 0 0-2.828 0L5 13V5h14v7.083c.718.12 1.393.368 2 .72V5a2 2 0 0 0-2-2z"
        />
        <path
          d="M17 9a2 2 0 1 1-4 0 2 2 0 0 1 4 0m1 5a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1m-1 7a1 1 0 1 1 2 0 1 1 0 0 1-2 0"
        />
      </svg>
      <span>
        Error downloading image
      </span>
    </span>
  </div>
</div>
`;

exports[`ImageBodyView > renders the hidden-media state 1`] = `
<div>
  <div
    class="root mx_MImageBody"
  >
    <div
      class="mx_MImageBody_thumbnail_container thumbnailContainer"
      style="max-height: 180px; max-width: 320px; aspect-ratio: 16 / 9;"
    >
      <div
        style="max-height: 180px; max-width: 320px;"
      >
        <div
          style="width: 320px; height: 180px;"
        >
          <button
            class="mx_HiddenMediaPlaceholder hiddenMediaPlaceholder"
            type="button"
          >
            <span
              class="hiddenMediaPlaceholderContent"
            >
              <svg
                fill="currentColor"
                height="1em"
                viewBox="0 0 24 24"
                width="1em"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M12 16q1.875 0 3.188-1.312Q16.5 13.375 16.5 11.5t-1.312-3.187T12 7 8.813 8.313 7.5 11.5t1.313 3.188T12 16m0-1.8q-1.125 0-1.912-.787A2.6 2.6 0 0 1 9.3 11.5q0-1.125.787-1.912A2.6 2.6 0 0 1 12 8.8q1.125 0 1.912.787.788.788.788 1.913t-.787 1.912A2.6 2.6 0 0 1 12 14.2m0 4.8q-3.475 0-6.35-1.837Q2.775 15.324 1.3 12.2a.8.8 0 0 1-.1-.312 3 3 0 0 1 0-.775.8.8 0 0 1 .1-.313q1.475-3.125 4.35-4.962Q8.525 4 12 4t6.35 1.838T22.7 10.8a.8.8 0 0 1 .1.313 3 3 0 0 1 0 .774.8.8 0 0 1-.1.313q-1.475 3.125-4.35 4.963Q15.475 19 12 19m0-2a9.54 9.54 0 0 0 5.188-1.488A9.77 9.77 0 0 0 20.8 11.5a9.77 9.77 0 0 0-3.613-4.012A9.54 9.54 0 0 0 12 6a9.55 9.55 0 0 0-5.187 1.487A9.77 9.77 0 0 0 3.2 11.5a9.77 9.77 0 0 0 3.613 4.012A9.54 9.54 0 0 0 12 17"
                />
              </svg>
              <span>
                Show image
              </span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;

exports[`ImageBodyView > renders the loading blurhash state 1`] = `
<div>
  <div
    class="root mx_MImageBody"
  >
    <a
      class="interactiveWrapper"
      href="https://example.com/image.png"
    >
      <div
        class="mx_MImageBody_thumbnail_container thumbnailContainer"
        style="max-height: 180px; max-width: 320px; aspect-ratio: 16 / 9;"
      >
        <div
          class="mx_MImageBody_placeholder placeholder placeholderBlurhash"
        >
          <div
            class="mx_Blurhash"
            style="display: inline-block; height: 180px; width: 320px; position: relative;"
          >
            <canvas
              height="32"
              style="position: absolute; inset: 0px; width: 100%; height: 100%;"
              width="32"
            />
          </div>
        </div>
        <div
          style="max-height: 180px; max-width: 320px;"
        >
          <img
            alt="A scenic mountain lake"
            class="mx_MImageBody_thumbnail thumbnail"
            src="data:image/svg+xml;utf8,%0A%20%20%20%20%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%20viewBox%3D%220%200%20320%20180%22%3E%0A%20%20%20%20%20%20%20%20%3Cdefs%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%25%22%20y1%3D%220%25%22%20x2%3D%22100%25%22%20y2%3D%22100%25%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%220%25%22%20stop-color%3D%22%23b3d4ff%22%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%22100%25%22%20stop-color%3D%22%23f7c7ff%22%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2FlinearGradient%3E%0A%20%20%20%20%20%20%20%20%3C%2Fdefs%3E%0A%20%20%20%20%20%20%20%20%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22url(%23g)%22%2F%3E%0A%20%20%20%20%20%20%20%20%3Ccircle%20cx%3D%2282%22%20cy%3D%2282%22%20r%3D%2234%22%20fill%3D%22%23fff6%22%2F%3E%0A%20%20%20%20%20%20%20%20%3Cpath%20d%3D%22M30%20150%20L130%2088%20L190%20138%20L240%20102%20L320%20180%20L0%20180%20Z%22%20fill%3D%22%231f3a5f%22%2F%3E%0A%20%20%20%20%3C%2Fsvg%3E%0A"
          />
          <span
            class="mx_MImageBody_banner banner"
          >
            sunset-over-the-lake.png
          </span>
        </div>
      </div>
    </a>
  </div>
</div>
`;
